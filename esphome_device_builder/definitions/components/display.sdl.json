{"id":"display.sdl","name":"SDL2 Display on host platform","description":"The `sdl` display platform allows you to use create an ESPHome display on a desktop system running Linux or MacOS. This is particularly useful for designing display layouts, since compiling and running a host binary is much faster than compiling for and flashing a microcontroller target system.","category":"display","docs_url":"https://esphome.io/components/display/sdl","image_url":"https://esphome.io/images/sdl.png","multi_conf":true,"provides":["sdl","snapshot"],"config_entries":[{"key":"update_interval","type":"time_period","label":"Update Interval","description":"The interval to re-draw the screen. Defaults to `1s`.","default_value":"1s","display_format":null,"help_link":"https://esphome.io/components/display/sdl#configuration-variables"},{"key":"dimensions","type":"nested","label":"Dimensions","required":true,"display_format":null,"config_entries":[{"key":"height","type":"integer","label":"Height","required":true,"display_format":null},{"key":"width","type":"integer","label":"Width","required":true,"display_format":null}]},{"key":"id","type":"id","label":"ID","description":"Manually specify the ID used for code generation.","advanced":true,"help_link":"https://esphome.io/components/display/sdl#configuration-variables"},{"key":"auto_clear_enabled","type":"boolean","label":"Auto Clear Enabled","description":"If the display should be cleared before each update. Defaults to `true` if a lambda or pages are configured, false otherwise.","default_value":"unspecified","display_format":null,"advanced":true,"help_link":"https://esphome.io/components/display/mipi_rgb#configuration-options"},{"key":"headless","type":"boolean","label":"Headless","description":"Draw into memory instead of opening a window. Defaults to `false`. See [Headless Operation](https://esphome.io/components/display/sdl#headless-operation). May not be used together with `window_options` or `snapshot_key`.","default_value":false,"display_format":null,"advanced":true,"help_link":"https://esphome.io/components/display/sdl#configuration-variables"},{"key":"lambda","type":"lambda","label":"Lambda","description":"The lambda to use for rendering the content on the display. See [Display Rendering Engine](https://esphome.io/components/display#display-engine) for more information.","display_format":null,"advanced":true,"help_link":"https://esphome.io/components/display/sdl#configuration-variables"},{"key":"pages","type":"nested","label":"Pages","description":"Show pages instead of a single lambda. See [Display Pages](https://esphome.io/components/display#display-pages).","display_format":null,"multi_value":true,"advanced":true,"help_link":"https://esphome.io/components/display/sdl#configuration-variables","config_entries":[{"key":"id","type":"id","label":"ID","required":true},{"key":"lambda","type":"lambda","label":"Lambda","required":true,"display_format":null,"advanced":true}]},{"key":"rotation","type":"string","label":"Rotation","description":"Set the rotation of the display. Everything you draw in `lambda:` will be rotated by this option. One of `0°` (default), `90°`, `180°`, `270°`.","display_format":null,"advanced":true,"help_link":"https://esphome.io/components/display/addressable_light#configuration-variables"},{"key":"sdl_options","type":"string","label":"Sdl Options","description":"Build arguments if required to specify include or library paths. Should not be required if SDL2 is properly installed.","default_value":"","display_format":null,"advanced":true,"help_link":"https://esphome.io/components/display/sdl#configuration-variables"},{"key":"setup_priority","type":"float","label":"Setup Priority","display_format":null,"advanced":true,"hidden":true},{"key":"show_test_card","type":"boolean","label":"Show Test Card","display_format":null,"advanced":true},{"key":"snapshot_key","type":"string","label":"Snapshot Key","description":"A key that saves a [snapshot](https://esphome.io/components/display/sdl#snapshots) when pressed, for example `SDLK_F12`. See the [SDL binary sensor](https://esphome.io/components/binary_sensor/sdl/) for the list of key names. Since this needs a keyboard, it may not be used with `headless`. Each press saves one snapshot; holding the key down does not keep saving them.","options":[{"label":"SDLK_UNKNOWN","value":"SDLK_UNKNOWN"},{"label":"SDLK_RETURN","value":"SDLK_RETURN"},{"label":"SDLK_ESCAPE","value":"SDLK_ESCAPE"},{"label":"SDLK_BACKSPACE","value":"SDLK_BACKSPACE"},{"label":"SDLK_TAB","value":"SDLK_TAB"},{"label":"SDLK_SPACE","value":"SDLK_SPACE"},{"label":"SDLK_EXCLAIM","value":"SDLK_EXCLAIM"},{"label":"SDLK_QUOTEDBL","value":"SDLK_QUOTEDBL"},{"label":"SDLK_HASH","value":"SDLK_HASH"},{"label":"SDLK_PERCENT","value":"SDLK_PERCENT"},{"label":"SDLK_DOLLAR","value":"SDLK_DOLLAR"},{"label":"SDLK_AMPERSAND","value":"SDLK_AMPERSAND"},{"label":"SDLK_QUOTE","value":"SDLK_QUOTE"},{"label":"SDLK_LEFTPAREN","value":"SDLK_LEFTPAREN"},{"label":"SDLK_RIGHTPAREN","value":"SDLK_RIGHTPAREN"},{"label":"SDLK_ASTERISK","value":"SDLK_ASTERISK"},{"label":"SDLK_PLUS","value":"SDLK_PLUS"},{"label":"SDLK_COMMA","value":"SDLK_COMMA"},{"label":"SDLK_MINUS","value":"SDLK_MINUS"},{"label":"SDLK_PERIOD","value":"SDLK_PERIOD"},{"label":"SDLK_SLASH","value":"SDLK_SLASH"},{"label":"SDLK_0","value":"SDLK_0"},{"label":"SDLK_1","value":"SDLK_1"},{"label":"SDLK_2","value":"SDLK_2"},{"label":"SDLK_3","value":"SDLK_3"},{"label":"SDLK_4","value":"SDLK_4"},{"label":"SDLK_5","value":"SDLK_5"},{"label":"SDLK_6","value":"SDLK_6"},{"label":"SDLK_7","value":"SDLK_7"},{"label":"SDLK_8","value":"SDLK_8"},{"label":"SDLK_9","value":"SDLK_9"},{"label":"SDLK_COLON","value":"SDLK_COLON"},{"label":"SDLK_SEMICOLON","value":"SDLK_SEMICOLON"},{"label":"SDLK_LESS","value":"SDLK_LESS"},{"label":"SDLK_EQUALS","value":"SDLK_EQUALS"},{"label":"SDLK_GREATER","value":"SDLK_GREATER"},{"label":"SDLK_QUESTION","value":"SDLK_QUESTION"},{"label":"SDLK_AT","value":"SDLK_AT"},{"label":"SDLK_LEFTB