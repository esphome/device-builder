_link":"https://esphome.io/components/display/sdl#configuration-variables","config_entries":[{"key":"always_on_top","type":"boolean","label":"Always On Top","description":"Whether to always draw the display window above other windows or not","default_value":false,"display_format":null,"advanced":true,"help_link":"https://esphome.io/components/display/sdl#configuration-variables"},{"key":"borderless","type":"boolean","label":"Borderless","description":"Whether to draw the display window with or without borders","default_value":false,"display_format":null,"advanced":true,"help_link":"https://esphome.io/components/display/sdl#configuration-variables"},{"key":"fullscreen","type":"boolean","label":"Fullscreen","description":"Whether to draw the display window in fullscreen or not. This may resize the resolution of the host display to match the SDL display dimensions","default_value":false,"display_format":null,"advanced":true,"help_link":"https://esphome.io/components/display/sdl#configuration-variables"},{"key":"position","type":"nested","label":"Position","description":"Specify the position of the display window on the host system. If not specified, SDL will choose a default position. Either `x` and `y` or `centered_on_display` may be used, but not together.","display_format":null,"advanced":true,"help_link":"https://esphome.io/components/display/sdl#configuration-variables","config_entries":[{"key":"centered_on_display","type":"integer","label":"Centered On Display","description":"For use with multiple display screens. Centers the window on the specified display number. Display numbering starts at 0. May not be used with `x` or `y`.","range":[0,128],"display_format":null,"advanced":true,"help_link":"https://esphome.io/components/display/sdl#configuration-variables"},{"key":"x","type":"integer","label":"X","description":"X position of the display window in pixels","display_format":null,"advanced":true,"help_link":"https://esphome.io/components/display/sdl#configuration-variables"},{"key":"y","type":"integer","label":"Y","description":"Y position of the display window in pixels","display_format":null,"advanced":true,"help_link":"https://esphome.io/components/display/sdl#configuration-variables"}]},{"key":"resizable","type":"boolean","label":"Resizable","description":"Whether the display window can be manually resized","default_value":false,"display_format":null,"advanced":true,"help_link":"https://esphome.io/components/display/sdl#configuration-variables"},{"key":"skip_taskbar","type":"boolean","label":"Skip Taskbar","description":"Whether to skip adding a taskbar icon for the display window or not","default_value":false,"display_format":null,"advanced":true,"help_link":"https://esphome.io/components/display/sdl#configuration-variables"}]}]}
