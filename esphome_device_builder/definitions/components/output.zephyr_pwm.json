{"id":"output.zephyr_pwm","name":"Zephyr PWM Output","description":"The Zephyr PWM platform allows you to use a hardware PWM on chips running the Zephyr RTOS like nRF52.","category":"output","docs_url":"https://esphome.io/components/output/zephyr_pwm","image_url":"https://esphome.io/images/pwm.png","dependencies":["zephyr"],"multi_conf":true,"config_entries":[{"key":"pin","type":"string","label":"Pin","description":"The pin to use PWM on.","required":true,"display_format":null,"help_link":"https://esphome.io/components/output/zephyr_pwm#configuration-variables"},{"key":"inverted","type":"boolean","label":"Inverted","display_format":null},{"key":"id","type":"id","label":"ID","description":"The id to use for this output component.","required":true,"help_link":"https://esphome.io/components/output/zephyr_pwm#configuration-variables"},{"key":"power_supply","type":"id","label":"Power Supply","display_format":null,"references_component":"power_supply"},{"key":"frequency","type":"float_with_unit","label":"Frequency","description":"The frequency to run the PWM with. Lower frequencies have more visual artifacts, but can represent much more colors. Defaults to `1kHz`.","default_value":"1kHz","range":[3.815,10000000.0],"display_format":null,"advanced":true,"help_link":"https://esphome.io/components/output/zephyr_pwm#configuration-variables","unit_options":["Hz","nHz","µHz","mHz","kHz","MHz","GHz"]},{"key":"max_power","type":"string","label":"Max Power","display_format":null,"advanced":true},{"key":"min_power","type":"string","label":"Min Power","display_format":null,"advanced":true},{"key":"setup_priority","type":"float","label":"Setup Priority","display_format":null,"advanced":true,"hidden":true},{"key":"zero_means_zero","type":"boolean","label":"Zero Means Zero","default_value":false,"display_format":null,"advanced":true}]}
