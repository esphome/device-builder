{"id":"mitsubishi_cn105.vane.control","name":"Mitsubishi Cn105 → Vane Control","description":"The `mitsubishi_cn105.vane.control` action changes the vane direction. Its `id` must reference the top-level Mitsubishi CN105 hub. It takes `vertical.direction` and `horizontal.direction`; at least one of `vertical` or `horizontal` must be set. Each can also be a lambda returning one of the corresponding `VERTICAL_VANE_MODE_*` or `HORIZONTAL_VANE_MODE_*` values. A lambda returning an `UNKNOWN` value is ignored and does not change that vane.","docs_url":"https://esphome.io/automations/actions","domain":"mitsubishi_cn105","config_entries":[{"key":"id","type":"id","label":"ID","description":"The ID of the top-level `mitsubishi_cn105` hub.","required":true,"display_format":null,"references_component":"mitsubishi_cn105","help_link":"https://esphome.io/components/climate/mitsubishi_cn105/#mitsubishi_cn105-vane-control-action"},{"key":"horizontal","type":"nested","label":"Horizontal","description":"Horizontal (wide) vane settings.","display_format":null,"advanced":true,"help_link":"https://esphome.io/components/climate/mitsubishi_cn105/#mitsubishi_cn105-vane-control-action","config_entries":[{"key":"direction","type":"string","label":"Direction","description":"One of `1` (far left), `2` (left), `3` (center), `4` (right), `5` (far right), `SPLIT` (left and right), or `SWING`.","required":true,"options":[{"label":"1","value":"1"},{"label":"2","value":"2"},{"label":"3","value":"3"},{"label":"4","value":"4"},{"label":"5","value":"5"},{"label":"SPLIT","value":"SPLIT"},{"label":"SWING","value":"SWING"}],"display_format":null,"templatable":true,"help_link":"https://esphome.io/components/climate/mitsubishi_cn105/#mitsubishi_cn105-vane-control-action"}]},{"key":"vertical","type":"nested","label":"Vertical","description":"Vertical vane settings.","display_format":null,"advanced":true,"help_link":"https://esphome.io/components/climate/mitsubishi_cn105/#mitsubishi_cn105-vane-control-action","config_entries":[{"key":"direction","type":"string","label":"Direction","description":"One of `AUTO`, `1`, `2`, `3`, `4`, `5`, or `SWING`.","required":true,"options":[{"label":"1","value":"1"},{"label":"2","value":"2"},{"label":"3","value":"3"},{"label":"4","value":"4"},{"label":"5","value":"5"},{"label":"AUTO","value":"AUTO"},{"label":"SWING","value":"SWING"}],"display_format":null,"templatable":true,"help_link":"https://esphome.io/components/climate/mitsubishi_cn105/#mitsubishi_cn105-vane-control-action"}]}],"is_control_flow":false,"has_else_branch":false,"has_condition_gate":false,"condition_gate_keys":[],"has_branches":false,"accepts_action_list":[],"scalar_shorthand_key":null}
