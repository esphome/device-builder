{"id":"lvgl.animation.start","name":"Lvgl → Animation Start","description":"Starts one or more animations. If an animation is already running it is restarted from the beginning. The `duration`, `start_delay` and `loop` options, if given, override the values configured on the animation for this and subsequent runs.","docs_url":"https://esphome.io/automations/actions","domain":"lvgl","config_entries":[{"key":"id","type":"id","label":"ID","description":"The ID of the animation to start, or a list of IDs.","required":true,"display_format":null,"multi_value":true,"references_component":"lvgl","help_link":"https://esphome.io/components/lvgl/animation/#lvgl-animation-start-action"},{"key":"lvgl_id","type":"id","label":"Lvgl ID","description":"The ID of the LVGL instance the animations belong to. Only required when more than one LVGL instance is configured.","display_format":null,"references_component":"lvgl","help_link":"https://esphome.io/components/lvgl/animation/#lvgl-animation-start-action"},{"key":"duration","type":"time_period","label":"Duration","description":"Override the animation's `duration`.","display_format":null,"advanced":true,"help_link":"https://esphome.io/components/lvgl/animation/#lvgl-animation-start-action"},{"key":"loop","type":"boolean","label":"Loop","description":"Override the animation's `loop` setting.","display_format":null,"advanced":true,"help_link":"https://esphome.io/components/lvgl/animation/#lvgl-animation-start-action"},{"key":"start_delay","type":"time_period","label":"Start Delay","description":"Override the animation's `start_delay`.","display_format":null,"advanced":true,"help_link":"https://esphome.io/components/lvgl/animation/#lvgl-animation-start-action"}],"is_control_flow":false,"has_else_branch":false,"has_condition_gate":false,"condition_gate_keys":[],"has_branches":false,"accepts_action_list":[],"scalar_shorthand_key":"id"}
