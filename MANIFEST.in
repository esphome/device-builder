include README.md
include LICENSE
graft esphome_device_builder
# YAML manifests are build-time sources, not runtime artefacts —
# the dashboard reads definitions/boards.json (generated by
# script/sync_boards.py) at startup. Drop them from wheel/sdist to
# avoid shipping duplicate data.
recursive-exclude esphome_device_builder/definitions/boards *.yaml
recursive-exclude * *.py[co]
